# ============================================================
#  STM32F746 手写数字识别 —— Git 忽略规则
#  说明：这些文件要么是构建产物，要么是体积很大的数据集，
#        一旦提交进历史就很难彻底删除，所以必须在这里排除。
# ============================================================

# ---------- 构建产物 ----------
build/
*.elf
*.map
*.bin
*.hex
*.su
*.o
*.d

# ---------- Python 缓存与数据集 ----------
HDR_PC/data/
HDR_PC/reports/
__pycache__/
*.py[cod]

# ---------- 编辑器 / 系统临时文件 ----------
*.log
Thumbs.db
desktop.ini
.DS_Store
*.swp

# ---------- 调试用的临时输出 ----------
*.zip
*.7z
*.bak
*.orig
